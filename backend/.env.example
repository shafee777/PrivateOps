# PrivateOps Backend Environment Variables
# Copy this file to .env and fill in your values

NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=privateops
DB_PORT=3306

# Redis (optional - falls back to in-memory if not available)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets (use strong random strings in production)
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Vault PIN JWT (for locked sensitive documents)
VAULT_JWT_SECRET=change_this_vault_secret_too

# Server
PORT=5000
